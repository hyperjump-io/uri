{
  "name": "@hyperjump/uri",
  "version": "1.4.0",
  "description": "A small and fast library for validating, parsing, and resolving URIs and IRIs",
  "keywords": [
    "URI",
    "IRI",
    "resolve",
    "relative",
    "parse",
    "RFC3986",
    "RFC-3986",
    "RFC3987",
    "RFC-3987"
  ],
  "author": "Jason Desrosiers <jdesrosi@gmail.com>",
  "license": "MIT",
  "repository": "github:hyperjump-io/uri",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/hyperjump-io"
  },
  "type": "module",
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "!src/**/*.test.js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./abnf": {
      "types": "./src/abnf.d.ts",
      "default": "./src/abnf.js"
    }
  },
  "scripts": {
    "generate": "node scripts/generate-patterns.js",
    "lint": "oxlint",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "version": "node scripts/version-docs.js && git add website"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "*",
    "@types/node": "*",
    "@vitest/coverage-v8": "*",
    "oxlint": "*",
    "oxlint-tsgolint": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
